<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clawd Usage" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
  <Border CornerRadius="10" Background="#FF1A1A1E" BorderBrush="#33FFFFFF"
          BorderThickness="1" Padding="12,10,12,11" Width="262">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.55" Color="Black"/>
    </Border.Effect>
    <StackPanel>

      <Grid Margin="0,0,0,6">
        <TextBlock Text="CLAUDE USAGE" FontFamily="Segoe UI" FontSize="9.5"
                   FontWeight="SemiBold" Foreground="#FF8B8B94" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <StackPanel x:Name="Hearts" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="0,0,12,0" Background="Transparent" Visibility="Collapsed"/>
          <TextBlock x:Name="BtnToggle" Text="&#x25BE;" FontSize="11" Foreground="#FF8B8B94"
                     Margin="0,0,9,0" Cursor="Hand" ToolTip="Details"/>
          <TextBlock x:Name="BtnHide" Text="&#x2013;" FontSize="13" Foreground="#FF8B8B94"
                     Margin="0,0,9,0" Cursor="Hand" ToolTip="Minimize to tray"/>
          <TextBlock x:Name="BtnExit" Text="&#x2715;" FontSize="11" Foreground="#FF8B8B94"
                     Cursor="Hand" ToolTip="Exit"/>
        </StackPanel>
      </Grid>

      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- sky across the whole row, behind the percentage and the mascot -->
        <Border x:Name="Sky" Grid.ColumnSpan="2" Margin="0,0,0,-3" ClipToBounds="True"
                ToolTipService.ShowDuration="60000">
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00000000" Offset="0"/>
              <GradientStop Color="#FF000000" Offset="0.1"/>
              <GradientStop Color="#FF000000" Offset="0.9"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Border.OpacityMask>
          <Canvas x:Name="SkyFx" IsHitTestVisible="False" Opacity="0.7"/>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <TextBlock x:Name="PctText" Text="--" FontFamily="Segoe UI" FontSize="30"
                     FontWeight="Light" Foreground="White"/>
          <TextBlock x:Name="PctSign" Text="%" FontFamily="Segoe UI" FontSize="14"
                     Foreground="#FF8B8B94" Margin="2,0,0,7"/>
        </StackPanel>
        <Canvas x:Name="MascotArea" Grid.Column="1" Margin="10,0,0,-3">
          <Canvas x:Name="Mascot" Width="36" Height="26.4" Background="Transparent" Cursor="Hand">
            <Path x:Name="MascotBody" Fill="#FFD77757"/>
            <Path x:Name="MascotEyes" Fill="#FF141416"/>
            <Path x:Name="MascotFx" Fill="#FF6B7280"/>
            <Path x:Name="MascotSand" Fill="#FFB8955E" IsHitTestVisible="False"/>
            <Rectangle x:Name="MascotSweat" Width="3" Height="4.5" Fill="#FF7DD3FC"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
          </Canvas>
          <TextBlock x:Name="MascotZ" Text="z" FontFamily="Segoe UI" FontWeight="SemiBold"
                     Foreground="#FF8B8B94" Visibility="Collapsed" IsHitTestVisible="False"/>
          <TextBlock x:Name="MascotBubble" Width="12" TextAlignment="Center" FontFamily="Segoe UI"
                     FontSize="11" FontWeight="Bold" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Path x:Name="MascotLove" Fill="#FFF87171" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Path x:Name="MascotSoul" Fill="#FFF4F4F5" Visibility="Collapsed" IsHitTestVisible="False"/>
          <TextBlock x:Name="MascotTag" Canvas.Left="0" Canvas.Top="0" FontFamily="Segoe UI"
                     FontSize="8" Foreground="#FF6B7280" IsHitTestVisible="False"/>
        </Canvas>
      </Grid>

      <Border Background="#26FFFFFF" CornerRadius="3" Height="6" Margin="0,0,0,7">
        <Border x:Name="BarSession" HorizontalAlignment="Left" CornerRadius="3"
                Background="#FF4ADE80" Width="0"/>
      </Border>

      <TextBlock x:Name="LineReset" Text="loading..." FontFamily="Segoe UI" FontSize="11"
                 Foreground="#FFD4D4D8" Margin="0,0,0,9"/>

      <Grid Margin="0,0,0,4">
        <TextBlock x:Name="LblWeek" Text="WEEK" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                   Foreground="#FF6B7280"/>
        <TextBlock x:Name="LineWeek" Text="" FontFamily="Segoe UI" FontSize="10"
                   Foreground="#FF8B8B94" HorizontalAlignment="Right"/>
      </Grid>
      <Border Background="#26FFFFFF" CornerRadius="2" Height="4" Margin="0,0,0,7">
        <Border x:Name="BarWeek" HorizontalAlignment="Left" CornerRadius="2"
                Background="#FF60A5FA" Width="0"/>
      </Border>

      <Grid x:Name="FableRow" Margin="0,0,0,4">
        <TextBlock x:Name="LblFable" Text="FABLE · WEEK" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                   Foreground="#FF6B7280"/>
        <TextBlock x:Name="LineFable" Text="" FontFamily="Segoe UI" FontSize="10"
                   Foreground="#FF8B8B94" HorizontalAlignment="Right"/>
      </Grid>
      <Border x:Name="FableBarBg" Background="#26FFFFFF" CornerRadius="2" Height="4">
        <Border x:Name="BarFable" HorizontalAlignment="Left" CornerRadius="2"
                Background="#FFA78BFA" Width="0"/>
      </Border>

      <StackPanel x:Name="SessionsPanel" Margin="0,10,0,0" Background="Transparent" ToolTipService.ShowDuration="60000">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LblSessions" Text="SESSIONS" FontFamily="Segoe UI" FontSize="9"
                     FontWeight="SemiBold" Foreground="#FF6B7280" Margin="0,0,8,0"/>
          <TextBlock x:Name="LineSessions" Grid.Column="1" Text="" FontFamily="Segoe UI" FontSize="10"
                     Foreground="#FF8B8B94" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </StackPanel>

      <Grid x:Name="StatusRow" Margin="0,10,0,0" Cursor="Hand" Background="Transparent"
            ToolTip="Open status.claude.com">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF6B7280"
                 VerticalAlignment="Top" Margin="0,4,6,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="LineStatus" Text="status: loading..." FontFamily="Segoe UI"
                     FontSize="10.5" Foreground="#FF8B8B94" TextWrapping="Wrap"/>
          <TextBlock x:Name="LineStatus2" Text="" FontFamily="Segoe UI" FontSize="10"
                     Foreground="#FF8B8B94" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,11,0,0">
       <StackPanel x:Name="StatsPanel">
        <Border Background="#1AFFFFFF" Height="1" Margin="0,0,0,8"/>

        <TextBlock x:Name="LblDay" Text="LAST 24 HOURS · THIS COMPUTER" FontFamily="Segoe UI" FontSize="9"
                   FontWeight="SemiBold" Foreground="#FF6B7280" Margin="0,0,0,3"/>
        <TextBlock x:Name="LineDay" Text="" FontFamily="Segoe UI" FontSize="10.5"
                   Foreground="#FFD4D4D8" Margin="0,0,0,2" TextWrapping="Wrap"/>
        <TextBlock x:Name="LineDay2" Text="" FontFamily="Segoe UI" FontSize="10"
                   Foreground="#FF8B8B94" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBlock x:Name="LblWeek7" Text="LAST 7 DAYS" FontFamily="Segoe UI" FontSize="9"
                   FontWeight="SemiBold" Foreground="#FF6B7280" Margin="0,0,0,3"/>
        <TextBlock x:Name="LineWeek7" Text="" FontFamily="Segoe UI" FontSize="10.5"
                   Foreground="#FFD4D4D8" Margin="0,0,0,2" TextWrapping="Wrap"/>
        <TextBlock x:Name="LineWeek72" Text="" FontFamily="Segoe UI" FontSize="10"
                   Foreground="#FF8B8B94" Margin="0,0,0,10" TextWrapping="Wrap"/>
       </StackPanel>

        <Border Background="#1AFFFFFF" Height="1" Margin="0,0,0,7"/>
        <TextBlock x:Name="LineVersion" Text="" FontFamily="Segoe UI" FontSize="10"
                   Foreground="#FF8B8B94" TextWrapping="Wrap" Background="Transparent"
                   ToolTipService.ShowDuration="60000"/>
      </StackPanel>

      <Grid Margin="0,7,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LineAccount" Text="" FontFamily="Segoe UI" FontSize="9"
                   Foreground="#FF52525B" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        <TextBlock x:Name="LineStamp" Grid.Column="1" Text="" FontFamily="Segoe UI" FontSize="9"
                   Foreground="#FF52525B"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
